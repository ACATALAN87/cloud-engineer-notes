---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/react/Hero';
import ValueProps from '../components/react/ValueProps';
import SkillGrid from '../components/react/SkillGrid';
import ExperienceTimeline from '../components/react/ExperienceTimeline';
import CertificationsGrid from '../components/react/CertificationsGrid';
import FeaturedProjectsTeaser from '../components/react/FeaturedProjectsTeaser';
import CTASection from '../components/react/CTASection';
import { getCollection } from 'astro:content';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const allProjects = await getCollection('projects', ({ data }) => !data.draft);

const dtFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' });

const featured = allProjects
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  })
  .slice(0, 3)
  .map((p) => ({
    slug:        p.id,
    title:       p.data.title,
    description: p.data.description,
    status:      p.data.status,
    category:    p.data.category,
    featured:    p.data.featured,
    stack:       p.data.stack,
    highlights:  p.data.highlights,
    repoUrl:     p.data.repoUrl,
    liveUrl:     p.data.liveUrl,
    href:        `${base}projects/${p.id.replace(/\.md$/, '')}/`,
    date:        dtFormatter.format(p.data.date),
  }));
---

<BaseLayout
  title="Ángel Luis Catalán | Senior Cloud Engineer"
  description="Senior Cloud Engineer specialised in Azure, Terraform, DevOps and enterprise infrastructure. Based in Madrid, Spain."
>
  <Hero client:load base={base} />

  <ValueProps client:visible />

  <SkillGrid client:visible />

  <ExperienceTimeline client:visible />

  <CertificationsGrid client:visible />

  <FeaturedProjectsTeaser client:visible projects={featured} base={base} />

  <CTASection />
</BaseLayout>
